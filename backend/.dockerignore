node_modules
npm-debug.log
.env
.git
.gitignore
# NOTE: `*.db` alone is NOT enough — Docker matches patterns against the whole
# relative path with Go filepath.Match semantics, where `*` never crosses a `/`.
# So `*.db` excludes a root-level foo.db but NOT data/expenses.db. The `data`
# entry below is what actually keeps the live database and the receipt photos
# in data/receipts/ out of the image.
*.db
data
dist
# Staged from node_modules by `npm run tessdata`, which the Dockerfile runs
# inside the image. Shipping a developer's copy through the build context would
# only be 5.6 MB of bytes the next RUN overwrites.
tessdata
coverage
*.md
Dockerfile
.dockerignore
