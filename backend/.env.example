# Backend configuration (copy to .env for local overrides)

# Port the API listens on
PORT=5000

# Path to the SQLite database file.
# Defaults to <cwd>/data/expenses.db when unset.
# DB_PATH=./data/expenses.db

# Optional single-user password gate. Leave unset to keep the API open (local
# dev / trusted LAN). When set, clients must log in and send a bearer token.
# APP_PASSWORD=change-me
# Optional signing secret for auth tokens (defaults to APP_PASSWORD if unset).
# AUTH_SECRET=some-long-random-string
