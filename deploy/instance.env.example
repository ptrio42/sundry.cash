# One Sundry instance. Copy to deploy/<name>.env and edit.
#
#   cp deploy/instance.env.example deploy/acme.env
#   COMPOSE_PROJECT_NAME=acme docker compose --env-file deploy/acme.env up -d
#
# NEVER commit the filled-in copy: deploy/*.env is gitignored, and it holds a
# real password. Only this .example file belongs in git.
#
# Every variable below is optional — the defaults in docker-compose.yml are the
# single-instance install. What a *second* instance on the same host must set is
# marked "per instance": those four collide otherwise, because container names
# and published ports are host-wide, not project-scoped.

# --- Identity (per instance) ------------------------------------------------
# Compose reads this from the env file itself, which beats remembering to put
# COMPOSE_PROJECT_NAME=... in front of every command: get it wrong once on a
# `down` and you have stopped somebody else's instance.
COMPOSE_PROJECT_NAME=acme
# Prefix for the container names: <INSTANCE>-backend, <INSTANCE>-frontend.
INSTANCE=acme
# Host directory holding this instance's SQLite file and receipt images.
# One directory per instance. Nothing is shared between them, ever.
DATA_DIR=/srv/sundry/data/acme
# Path *inside the container* — leave it unless you have a reason.
# DB_PATH=/app/data/expenses.db

# --- Where it listens (per instance) ----------------------------------------
# Port on the host. Must be unique per instance; the front proxy maps the
# hostname to it (see deploy/Caddyfile).
HTTP_PORT=8849
# Bind to loopback so the only way in is the proxy, which terminates TLS.
# Leave it at 0.0.0.0 only for a LAN install with no proxy in front.
BIND_ADDR=127.0.0.1

# --- Auth -------------------------------------------------------------------
# REQUIRED for anything reachable from the internet. With no password the API
# is fully open by design — that default exists for localhost, not for a
# hostname. Generate: openssl rand -base64 24
APP_PASSWORD=
# Independent signing key for bearer tokens. Without it, tokens are signed with
# the password itself. Generate the same way.
AUTH_SECRET=

# --- Instance flags ---------------------------------------------------------
# Public demo: the UI shows a banner saying the data is fictional and resets
# nightly. A customer instance leaves this false.
DEMO_MODE=false
# Receipt upload and OCR. Off means /api/receipts answers 403 and the tab
# disappears. Turn it off on any instance a stranger can reach without a
# password: OCR is Tesseract on your CPU, and an open endpoint is a free
# compute service for whoever finds it.
RECEIPTS_ENABLED=true
