# Frontend configuration (copy to .env for local overrides)

# Base URL for the API. Leave unset to use the relative "/api" path, which works
# both in Docker (nginx proxies /api -> backend) and in local dev (Vite proxies
# /api -> http://localhost:5000). Only set this for a non-proxied setup, e.g.:
# VITE_API_BASE_URL=http://localhost:5000/api
