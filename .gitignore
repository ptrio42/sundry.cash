# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database files (WAL mode adds the -wal / -shm sidecars)
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Environment variables
.env
.env.local
.env.*.local
# One env file per hosted instance: real passwords, one per customer. Only
# deploy/instance.env.example is tracked (it ends in .example, so it is not
# matched here).
deploy/*.env

# IDE / agent tooling
.vscode/
.idea/
# Machine-local Claude Code permissions; .claude/launch.json is intentionally tracked.
.claude/settings.local.json
# Personal / sandbox-only notes — CLAUDE.md points here precisely because it is untracked.
CLAUDE.local.md
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build outputs
dist/
build/
*.tsbuildinfo
# OCR language data, copied out of node_modules by `npm run tessdata`. Derived
# bytes with a source in package-lock.json, so it is regenerated, not tracked.
backend/tessdata/

# Logs
logs/
*.log

