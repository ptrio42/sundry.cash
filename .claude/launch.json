{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "demo",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["cross-env", "DB_PATH=./data/demo.db", "npm", "run", "dev"],
      "port": 5173
    },
    {
      "name": "demo-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "concurrently", "-k", "-n", "backend,frontend", "-c", "blue,magenta",
        "cross-env PORT=5176 DB_PATH=./data/demo.db npm --prefix backend run dev",
        "cross-env VITE_DEV_PORT=5175 VITE_API_TARGET=http://localhost:5176 npm --prefix frontend run dev -- --no-open"
      ],
      "port": 5175
    },
    {
      "name": "receipt-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5174", "--strictPort", "--no-open"],
      "port": 5174
    }
  ]
}
